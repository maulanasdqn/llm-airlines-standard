{
  "verbs": [
    {"word": "get", "meaning": "Return a value that is already in memory. No I/O.", "not_for": "network (fetch), storage (load), slow work (compute)"},
    {"word": "set", "meaning": "Replace one value in memory.", "not_for": "a change to a stored entity (update)"},
    {"word": "find", "meaning": "Search for one item. Return nothing when there is no match.", "not_for": "a search that must succeed (get)"},
    {"word": "list", "meaning": "Return all items that match, as a collection. The collection can be empty.", "not_for": "one item (find)"},
    {"word": "count", "meaning": "Return the number of items.", "not_for": "the items themselves (list)"},
    {"word": "fetch", "meaning": "Get a value from a remote system over the network.", "not_for": "local storage (load)"},
    {"word": "load", "meaning": "Read a stored value from a disk, a database, or a cache into memory.", "not_for": "network calls (fetch)"},
    {"word": "save", "meaning": "Write a value to persistent storage. Create it or replace it.", "not_for": "a stream (write)"},
    {"word": "read", "meaning": "Read bytes, lines, or records from a stream or a file.", "not_for": "a parsed value (parse or load)"},
    {"word": "write", "meaning": "Write bytes, lines, or records to a stream or a file.", "not_for": "a stored entity (save)"},
    {"word": "create", "meaning": "Make a new persistent entity and give it an identity. Fail if it exists.", "not_for": "a value in memory only (build)"},
    {"word": "build", "meaning": "Construct a value in memory from its parts. No I/O.", "not_for": "a persistent entity (create)"},
    {"word": "update", "meaning": "Change some fields of an existing entity. Fail if it does not exist.", "not_for": "a value in memory (set)"},
    {"word": "delete", "meaning": "Remove an entity from storage permanently.", "not_for": "an item in a collection (remove)"},
    {"word": "add", "meaning": "Put an item into a collection.", "not_for": "a new persistent entity (create)"},
    {"word": "remove", "meaning": "Take an item out of a collection. The item can still exist in other places.", "not_for": "permanent removal from storage (delete)"},
    {"word": "insert", "meaning": "Put an item into a collection at a given position.", "not_for": "a collection with no order (add)"},
    {"word": "append", "meaning": "Put an item at the end of a sequence.", "not_for": "a collection with no order (add)"},
    {"word": "clear", "meaning": "Remove all items from a collection.", "not_for": "a full object state (reset)"},
    {"word": "reset", "meaning": "Put an object back into its initial state.", "not_for": "a collection only (clear)"},
    {"word": "replace", "meaning": "Put a new value in the place of an old value.", "not_for": "a partial change (update)"},
    {"word": "rename", "meaning": "Give an existing item a new name.", "not_for": "a move to a different location (move)"},
    {"word": "move", "meaning": "Put an existing item in a different location.", "not_for": "a duplicate (copy)"},
    {"word": "copy", "meaning": "Make an independent duplicate.", "not_for": "a shared reference (get)"},
    {"word": "parse", "meaning": "Convert text or bytes into a structured value. Fail on bad input.", "not_for": "output for people (format)"},
    {"word": "format", "meaning": "Convert a structured value into text for people.", "not_for": "a wire format (encode)"},
    {"word": "encode", "meaning": "Convert a value into a wire format or a storage format.", "not_for": "text for people (format)"},
    {"word": "decode", "meaning": "Convert a wire format or a storage format into a value.", "not_for": "free text (parse)"},
    {"word": "to", "meaning": "Convert a value to a different type. No side effects.", "not_for": "a conversion that can fail (parse)"},
    {"word": "normalize", "meaning": "Convert a value into its one canonical form.", "not_for": "a check (validate)"},
    {"word": "escape", "meaning": "Replace special characters so that a different language reads the text literally.", "not_for": "a removal of characters (strip)"},
    {"word": "strip", "meaning": "Remove characters or markup from text.", "not_for": "a removal of a collection item (remove)"},
    {"word": "split", "meaning": "Divide one value into a sequence of parts.", "not_for": "a filter of items (filter)"},
    {"word": "join", "meaning": "Combine a sequence of parts into one value.", "not_for": "a combination of two records (merge)"},
    {"word": "merge", "meaning": "Combine two or more records into one record.", "not_for": "a sequence of text parts (join)"},
    {"word": "sort", "meaning": "Put items in order.", "not_for": "a removal of items (filter)"},
    {"word": "filter", "meaning": "Keep only the items that match a condition.", "not_for": "one item (find)"},
    {"word": "map", "meaning": "Apply one function to each item and return the results.", "not_for": "side effects only (apply)"},
    {"word": "compare", "meaning": "Return the order of two values or the difference between them.", "not_for": "a pass or fail result (validate)"},
    {"word": "match", "meaning": "Test a value against a pattern. Return the match or nothing.", "not_for": "a rule set (validate)"},
    {"word": "compute", "meaning": "Derive a value from inputs. No side effects. It can be slow.", "not_for": "a value in memory (get)"},
    {"word": "measure", "meaning": "Record the size, the duration, or the rate of an operation.", "not_for": "a count of items (count)"},
    {"word": "validate", "meaning": "Test a value against rules. Return the result or the list of errors. Do not throw for bad input.", "not_for": "a guard that throws (assert)"},
    {"word": "assert", "meaning": "Test a condition. Throw or panic when it is false.", "not_for": "a test that returns a result (validate)"},
    {"word": "ensure", "meaning": "Make a condition true. Do nothing when it is already true.", "not_for": "a test only (validate)"},
    {"word": "resolve", "meaning": "Find the final value of a reference, such as a path, a host name, or a promise.", "not_for": "a search in a collection (find)"},
    {"word": "send", "meaning": "Transmit a message to one known receiver.", "not_for": "an event for many listeners (emit)"},
    {"word": "emit", "meaning": "Publish an event to zero or more listeners. Do not wait for them.", "not_for": "one known receiver (send)"},
    {"word": "subscribe", "meaning": "Register a listener for an event.", "not_for": "a registry entry (register)"},
    {"word": "unsubscribe", "meaning": "Remove a listener for an event.", "not_for": "a registry entry (unregister)"},
    {"word": "register", "meaning": "Add an item to a registry so that other code can find it.", "not_for": "an event listener (subscribe)"},
    {"word": "unregister", "meaning": "Remove an item from a registry.", "not_for": "an event listener (unsubscribe)"},
    {"word": "start", "meaning": "Begin a process, a service, or a timer that runs for a long time.", "not_for": "a job that runs to completion (run)"},
    {"word": "stop", "meaning": "End a process, a service, or a timer.", "not_for": "an operation that did not begin (cancel)"},
    {"word": "run", "meaning": "Execute a job, a command, or a task to completion.", "not_for": "a long-running service (start)"},
    {"word": "cancel", "meaning": "Stop a pending operation before it completes.", "not_for": "a running service (stop)"},
    {"word": "schedule", "meaning": "Arrange an operation to run at a later time.", "not_for": "an operation that runs now (run)"},
    {"word": "wait", "meaning": "Block until a condition is true or a timeout ends.", "not_for": "a later operation (schedule)"},
    {"word": "retry", "meaning": "Run an operation again after it fails.", "not_for": "the first attempt (run)"},
    {"word": "open", "meaning": "Acquire a resource handle, such as a file or a connection.", "not_for": "a network session (connect)"},
    {"word": "close", "meaning": "Release a resource handle.", "not_for": "a network session (disconnect)"},
    {"word": "connect", "meaning": "Start a session with a remote system.", "not_for": "a local file (open)"},
    {"word": "disconnect", "meaning": "End a session with a remote system.", "not_for": "a local file (close)"},
    {"word": "lock", "meaning": "Get exclusive access to a resource.", "not_for": "a permission change (disable)"},
    {"word": "unlock", "meaning": "Release exclusive access to a resource.", "not_for": "a permission change (enable)"},
    {"word": "enable", "meaning": "Turn on a feature or a setting.", "not_for": "a service (start)"},
    {"word": "disable", "meaning": "Turn off a feature or a setting.", "not_for": "a service (stop)"},
    {"word": "apply", "meaning": "Put a change, a patch, or a configuration into effect on a target.", "not_for": "a conversion (map)"},
    {"word": "render", "meaning": "Produce output for display, such as a page, a view, or a template.", "not_for": "text for a log (format)"},
    {"word": "show", "meaning": "Make a user interface element visible.", "not_for": "output to a stream (write)"},
    {"word": "hide", "meaning": "Make a user interface element invisible.", "not_for": "a removal (remove)"},
    {"word": "log", "meaning": "Write one event to the log.", "not_for": "output for the user (write)"},
    {"word": "import", "meaning": "Bring external records into the system.", "not_for": "a stored value (load)"},
    {"word": "export", "meaning": "Send records out of the system in an external format.", "not_for": "a stored value (save)"},
    {"word": "upload", "meaning": "Send a file to a remote system.", "not_for": "a message (send)"},
    {"word": "download", "meaning": "Get a file from a remote system.", "not_for": "a structured value (fetch)"},
    {"word": "install", "meaning": "Put a package, a hook, or a component in place so that it can run.", "not_for": "a registry entry (register)"},
    {"word": "uninstall", "meaning": "Remove an installed package, hook, or component.", "not_for": "a stored entity (delete)"},
    {"word": "push", "meaning": "Put an item on the top of a stack or the end of a queue.", "not_for": "a collection with no order (add)"},
    {"word": "pop", "meaning": "Take the item from the top of a stack or the front of a queue.", "not_for": "a collection with no order (remove)"},
    {"word": "wrap", "meaning": "Put a value inside a different value that adds context.", "not_for": "a type conversion (to)"},
    {"word": "accept", "meaning": "Take an incoming request, a connection, or an offer.", "not_for": "a check (validate)"},
    {"word": "reject", "meaning": "Refuse an incoming request, a connection, or an offer.", "not_for": "a removal (remove)"},
    {"word": "test", "meaning": "Make sure that code obeys its contract. Use it only in test code.", "not_for": "production checks (validate)"}
  ],
  "predicates": [
    {"word": "is", "meaning": "The value is in a state or belongs to a kind."},
    {"word": "has", "meaning": "The value owns or contains an item."},
    {"word": "can", "meaning": "The actor has the permission or the capability."},
    {"word": "should", "meaning": "A policy decides that the action is correct."}
