  "prefixes": [
    {"word": "on", "meaning": "An event callback. The rest of the name is the event.", "example": "onOrderCanceled"},
    {"word": "try", "meaning": "Return a result or nothing instead of an exception. The next word is an approved verb.", "example": "tryParseDate"}
