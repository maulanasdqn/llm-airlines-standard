[lint]
preview = true
explicit-preview-rules = true
select = [
  "N",
  "C90",
  "FBT",
  "SIM",
  "RET",
  "ERA",
  "E741",
  "ANN001",
  "ANN201",
  "PLR0912",
  "PLR0915",
  "PLR0917",
  "PLR1702",
  "PLR2004",
]

[lint.mccabe]
max-complexity = {{ limits.code.complexity }}

[lint.pylint]
max-positional-args = {{ limits.code.positional_params }}
max-branches = {{ limits.code.complexity }}
max-statements = {{ limits.code.function_lines }}
max-nested-blocks = {{ limits.code.nesting_depth }}
